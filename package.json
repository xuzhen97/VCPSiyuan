{
  "name": "vcp-siyuan",
  "version": "0.1.0",
  "description": "Connect SiYuan with Vikunja and VCP services",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "dev:play": "vite",
    "dev:real": "node scripts/dev-real.mjs",
    "dev:real:web": "node scripts/dev-real.mjs --web",
    "dev:real:clean": "node scripts/dev-real.mjs --clean",
    "dev:vikunja": "node scripts/dev-vikunja.mjs",
    "dev:vikunja:clean": "node scripts/dev-vikunja.mjs --clean",
    "dev": "run-p dev:kernel dev:app",
    "dev:app": "webpack --config webpack.config.cjs --mode development",
    "dev:kernel": "webpack --config webpack.kernel.config.cjs --mode development",
    "build": "run-s build:kernel build:app verify:package",
    "build:app": "webpack --config webpack.config.cjs --mode production",
    "build:kernel": "webpack --config webpack.kernel.config.cjs --mode production",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "vikunja",
    "vcp"
  ],
  "author": "xuzhen97",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "adm-zip": "^0.5.16",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.4.3",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^3.0.7",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  }
}
